# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Create a project at https://neon.tech and copy the pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth (Clerk) ───────────────────────────────────────────────────────────
# Create an app at https://dashboard.clerk.com and copy the API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/admin/login"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/admin"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/admin"

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Create an API key at https://resend.com/api-keys and verify a sending domain.
RESEND_API_KEY="re_xxx"
# Address that outgoing emails are sent from (must be on a verified domain).
EMAIL_FROM="SCA <no-reply@surinamecollegeofaccountancy.com>"
# Address that receives new-booking and contact notifications.
ADMIN_EMAIL="info@surinamecollegeofaccountancy.com"

# ─── App ────────────────────────────────────────────────────────────────────
# Public base URL, used to build cancel links in emails. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
